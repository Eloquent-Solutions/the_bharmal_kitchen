{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/check-vercel-env.mjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "the-bharmal-kitchen.vercel.app"
        }
      ],
      "destination": "https://tbk.eloquentsolutions.in/:path*",
      "permanent": false
    }
  ]
}
