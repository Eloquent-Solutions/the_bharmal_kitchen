# Local, self-contained demo (default if this file is absent)
VITE_DATA_MODE=demo

# To use a Firebase project, set VITE_DATA_MODE=firebase and fill every value below.
# Firebase web config values are public identifiers, not server-side secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Set to true for an internal-only site. Public ordering and sign-up are disabled.
# VITE_STAFF_ONLY=true

# Set to true for the first client release. Only inventory, receiving, valuation,
# and owner access management are shown; other routes redirect to inventory.
# VITE_INVENTORY_ONLY=true

# Optional: only for local Firebase emulators in development.
# VITE_USE_FIREBASE_EMULATORS=true
