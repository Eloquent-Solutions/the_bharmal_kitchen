# Local, self-contained demo (default if this file is absent)
VITE_DATA_MODE=demo

# To use a Firebase project, set VITE_DATA_MODE=firebase and fill every value below.
# Firebase web config values are public identifiers, not server-side secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Set to true for an internal-only site. Public ordering and sign-up are disabled.
# VITE_STAFF_ONLY=true

# Set to true for the first client release. Only inventory, receiving, valuation,
# and owner access management are shown; other routes redirect to inventory.
# VITE_INVENTORY_ONLY=true

# Enable staff POS billing and order history alongside inventory when released.
# VITE_BILLING_ENABLED=true
# Enable kitchen/order operations and customer pickup requests when released.
# VITE_OPERATIONS_ENABLED=true
# VITE_CUSTOMER_TAKEAWAY_ENABLED=true
# Finance review: requires updated Firestore rules and an open register shift.
# VITE_FINANCE_ENABLED=true

# Optional: only for local Firebase emulators in development.
# VITE_USE_FIREBASE_EMULATORS=true

# Hosted builds require restaurant isolation. Local Firebase mode also enables it
# automatically for the development project, with restaurant tbk.
# VITE_MULTI_RESTAURANT=true
# VITE_PLATFORM_DOMAIN=eloquentsolutions.in
# Only used locally on localhost/127.0.0.1 (never a hosted fallback).
# VITE_LOCAL_RESTAURANT_ID=tbk
# Local and Vercel Preview use the-bharmal-s-kitchen; Vercel Production uses
# the-bharmal-kitchen. Supply all six matching web config values for each target.
# Deployment/Preview hostname metadata comes from Vercel, not public env settings.
