rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['Owner', 'Admin']);
    }

    function isStaff() {
      return hasRole([
        'Owner', 'Admin', 'Manager', 'Cashier', 'Chef', 'Kitchen Staff',
        'Waiter', 'Captain', 'Inventory Manager', 'Accountant', 'Staff'
      ]);
    }

    function isActiveCustomer() {
      return hasRole(['Customer']);
    }

    function financeReader() { return hasRole(['Owner', 'Admin', 'Manager', 'Accountant']); }
    function financeWriter() { return hasRole(['Owner', 'Admin', 'Manager']); }
    function financeCollection(name) { return name in ['orders', 'finance_registers', 'finance_entries', 'expenses', 'shifts', 'day_close']; }
    function openFinanceShift(id) {
      return getAfter(/databases/$(database)/documents/shifts/$(id)).data.status == 'open';
    }

    match /finance_registers/{id} {
      allow read: if financeReader();
      allow create, update: if financeWriter() && id == 'main'
        && request.resource.data.revision is number;
      allow delete: if false;
    }
    match /finance_entries/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.id == id
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.method in ['cash', 'upi', 'bank']
        && request.resource.data.direction in ['in', 'out']
        && request.resource.data.kind in ['sale', 'supplier_payment', 'expense', 'expense_reversal', 'transfer']
        && openFinanceShift(request.resource.data.shiftId);
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.schemaVersion == 2
        && request.resource.data.id == id && request.resource.data.createdById == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.method in ['cash', 'upi', 'bank']
        && request.resource.data.status == 'posted' && openFinanceShift(request.resource.data.shiftId);
      allow update: if financeWriter() && resource.data.status == 'posted' && request.resource.data.status == 'void'
        && request.resource.data.voidedById == request.auth.uid
        && request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedById', 'updatedAt'])
        && openFinanceShift(resource.data.shiftId);
      allow delete: if false;
    }
    match /shifts/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.id == id
        && request.resource.data.schemaVersion == 2 && request.resource.data.status == 'open'
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.openingCash is number && request.resource.data.openingCash >= 0
        && getAfter(/databases/$(database)/documents/finance_registers/main).data.activeShiftId == id;
      allow update: if financeWriter() && resource.data.status == 'open'
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cashSales', 'upiSales', 'cashIn', 'cashOut', 'cashExpenses', 'supplierCash', 'updatedAt', 'status', 'expectedCash', 'actualCash', 'variance', 'note', 'closedAt', 'closedById', 'closedBy']);
      allow delete: if false;
    }
    match /day_close/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.schemaVersion == 2
        && request.resource.data.businessDate == id && request.resource.data.createdById == request.auth.uid
        && getAfter(/databases/$(database)/documents/finance_registers/main).data.lastClosedDate == id
        && getAfter(/databases/$(database)/documents/finance_registers/main).data.activeShiftId == null;
      allow update, delete: if false;
    }

    // Kitchen status updates cannot rewrite prices, tax, costs, or payments.
    // The current billing release is restricted to Owner/Admin/Manager.
    match /orders/{id} {
      allow read: if isStaff();
      allow get: if isActiveCustomer() && resource.data.customerUid == request.auth.uid;
      allow create: if financeWriter() && request.resource.data.id == id
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.paymentStatus in ['pending', 'paid'];
      allow update: if financeWriter() && resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentStatus == 'paid' && resource.data.status != 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentMethod', 'paidAt', 'paymentEntryId', 'paymentBusinessDate', 'paymentShiftId', 'updatedAt']);
      allow update: if hasRole(['Owner', 'Admin', 'Manager', 'Chef', 'Kitchen Staff'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cookingStartedAt', 'updatedAt'])
        && ((resource.data.status == 'received' && request.resource.data.status == 'cooking')
          || (resource.data.status == 'cooking' && request.resource.data.status == 'ready')
          || (resource.data.status == 'ready' && request.resource.data.status == 'completed')
          || (resource.data.status == 'received' && request.resource.data.status == 'cancelled'
            && financeWriter() && resource.data.paymentStatus != 'paid'
            && (!resource.data.keys().hasAny(['businessDate'])
              || !exists(/databases/$(database)/documents/day_close/$(resource.data.businessDate)))));
      allow delete: if false;
    }

    // A first-time sign-in can create only its own Customer profile. Owners
    // assign staff roles through the admin UI or Firebase Console.
    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'Customer'
        && request.resource.data.status == 'active'
        && request.resource.data.allowedTabs == []
      );
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
      );
      allow delete: if isAdmin();
    }

    // Customers submit a pickup request only. Staff reprice and validate each
    // dish through the POS transaction before creating a bill or kitchen ticket.
    match /takeaway_requests/{requestId} {
      allow get: if hasRole(['Owner', 'Admin', 'Manager']) || (isActiveCustomer() && resource.data.customerUid == request.auth.uid);
      allow list: if hasRole(['Owner', 'Admin', 'Manager']) || (isActiveCustomer() && resource.data.customerUid == request.auth.uid);
      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly(['id', 'customerUid', 'customer', 'phone', 'items', 'notes', 'orderType', 'paymentMethod', 'paymentStatus', 'status', 'createdAt'])
        && request.resource.data.id == requestId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.orderType == 'takeaway'
        && request.resource.data.paymentMethod == 'cash'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.customer is string
        && request.resource.data.customer.size() > 0
        && request.resource.data.customer.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20;
      allow update: if hasRole(['Owner', 'Admin', 'Manager']);
      allow delete: if isAdmin();
    }

    match /{collection}/{document} {
      // Owner and Admin can manage top-level operational documents.
      allow read, write: if isAdmin() && !financeCollection(collection);

      allow read: if signedIn() && collection in ['menu_items', 'categories'];

      allow read: if isStaff() && collection in [
        'menu_items', 'categories', 'combos', 'modifiers', 'promotions',
        'orders', 'kots', 'tables', 'branches', 'settings',
        'printers', 'print_routing', 'print_queue'
      ];
      allow write: if hasRole(['Manager', 'Chef']) && collection in [
        'menu_items', 'categories', 'combos', 'modifiers'
      ];
      allow write: if hasRole(['Manager'])
        && collection in ['promotions', 'branches', 'settings', 'printers', 'print_routing']
        && (collection != 'settings' || document != 'restaurant');
      allow write: if hasRole(['Manager', 'Cashier', 'Chef', 'Kitchen Staff', 'Waiter', 'Captain'])
        && collection in ['kots', 'tables'];
      allow write: if hasRole(['Manager', 'Cashier', 'Chef']) && collection == 'print_queue';

      allow read: if hasRole(['Manager', 'Chef', 'Kitchen Staff', 'Inventory Manager', 'Accountant'])
        && collection in ['raw_materials', 'recipes', 'utensils', 'stock_movements', 'wastage'];
      allow write: if hasRole(['Manager', 'Chef', 'Inventory Manager'])
        && collection in ['raw_materials', 'recipes', 'utensils', 'stock_movements', 'wastage'];
      allow create: if hasRole(['Kitchen Staff']) && collection == 'wastage';

      allow read: if hasRole(['Manager', 'Inventory Manager', 'Accountant'])
        && collection in ['suppliers', 'supply_categories', 'kitchen_stations', 'purchase_bills', 'purchase_orders'];
      allow read: if hasRole(['Chef', 'Kitchen Staff']) && collection == 'kitchen_stations';
      allow write: if hasRole(['Manager', 'Inventory Manager'])
        && collection in ['suppliers', 'supply_categories', 'kitchen_stations', 'purchase_bills', 'purchase_orders'];

      allow read, write: if hasRole(['Manager', 'Cashier', 'Waiter', 'Captain'])
        && collection in ['customers', 'reservations', 'waitlist', 'inbox', 'inbox_messages'];

      allow read: if hasRole(['Manager', 'Accountant'])
        && collection in ['staff', 'leaves', 'advances', 'attendance', 'cash_transactions',
          'cash_drawer', 'audit_logs'];
      allow write: if hasRole(['Manager'])
        && collection in ['staff', 'leaves', 'advances', 'attendance', 'cash_transactions',
          'cash_drawer'];
      allow read, write: if hasRole(['Cashier'])
        && collection in ['cash_transactions', 'cash_drawer'];
      allow create: if isStaff() && collection == 'audit_logs';
    }
  }
}
